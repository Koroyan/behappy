# Copy to deploy/.env.production (git-ignored) and fill in. Never commit it.
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=change-me-long-random

PUBLIC_API_URL=https://api.example.com
APP_PUBLIC_URLS=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Generate each key with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
MESSAGE_ENCRYPTION_KEY=
IDENTIFIER_HMAC_KEY=

OPENAI_API_KEY=

# Email (registration codes, password reset, reminders) via resend.com
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM=BeHappy <no-reply@example.com>

# SMS for professional phone verification via Twilio Verify
SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Flitt stays TEST only (public sandbox merchant). Live payments need a separate reviewed change.
FLITT_MODE=test

# BeHappy Professional membership (TEST values; 0% commission on sessions)
PRO_PRICE_MINOR=7900
PRO_DURATION_DAYS=30
PRO_TRIAL_DAYS=14
PRO_GRACE_DAYS=0

SUPPORT_EMAIL=
