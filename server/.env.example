# BeHappy API server — copy to server/.env (never commit server/.env).

# --- AI ---------------------------------------------------------------
# Server-side only. Never prefix with EXPO_PUBLIC_ (that ships it to every user).
OPENAI_API_KEY=
# Optional safety ceiling for all proxied AI requests per UTC day.
AI_GLOBAL_DAILY_REQUEST_CAP=5000
# Models per feature (the server decides, never the app). The instructions are
# server-owned Markdown in server/prompts/; nothing is hosted on the OpenAI
# dashboard any more (old app builds' prompt ids are accepted and replaced).
# AI_MODEL_ANULIA=gpt-5.4-mini
# AI_MODEL_CARDS=gpt-5.4-mini
# AI_MODEL_COMMUNITY=gpt-5.4-mini
# Art reflection (docs/BEHAPPY_AI_MODEL_EVALUATION.md): GPT-6.1 Sol, medium reasoning.
# AI_MODEL_ART=gpt-6.1-sol
# Used once per turn if the art model isn't available to this OpenAI project.
# AI_MODEL_ART_FALLBACK=gpt-5.4-mini
# none | minimal | low | medium | high | xhigh (high was slower and not better in the evaluation)
# AI_REASONING_ART=medium
# Output budget incl. reasoning tokens (2048–32000); too small cuts the JSON off.
# AI_ART_MAX_OUTPUT_TOKENS=8000
# true: OpenAI stores responses (30 days by default) so turns chain with
# previous_response_id (fewer tokens). false: nothing is stored at OpenAI; the
# app resends its own session history each turn (more input tokens).
# AI_ART_STORE=true
# AI_ART_TIMEOUT_MS=120000

# --- URLs ---------------------------------------------------------------
PORT=8787
# Public URL of this API. Flitt redirects the browser here after checkout.
PUBLIC_API_URL=http://localhost:8787
# Web app URL(s); first one is the default post-payment destination.
APP_PUBLIC_URLS=http://localhost:8081
APP_SCHEME=behappy

# --- Payments: Flitt TEST MODE ONLY --------------------------------------
# Public sandbox merchant from https://docs.flitt.com/api/testing/
FLITT_MODE=test
FLITT_MERCHANT_ID=1549901
FLITT_SECRET_KEY=test
FLITT_ORDER_LIFETIME_SECONDS=3600
# Product catalog: current (pre-2.0 prices) or proposal (see pricing doc).
BEHAPPY_CATALOG=current

# --- Admin (test refunds) -----------------------------------------------
# Long random string. Enables POST /api/admin/orders/:id/refund for testing.
ADMIN_TOKEN=

# Express "trust proxy". Leave empty locally (only a proxy on this machine is
# trusted). Behind a hosting load balancer, set 1 so per-IP limits see the real
# client address. Never trust more hops than you actually have.
TRUST_PROXY=

# --- Phone notifications (Expo push) ------------------------------------
# expo (default): sent through Expo's free push service. log: printed here,
# never sent (useful offline). off: disabled. Message text is never pushed.
# PUSH_DRIVER=expo
# Only if "enhanced push security" is on for the Expo project:
# EXPO_ACCESS_TOKEN=

# --- Web app notifications and reminders (Web Push, VAPID) --------------
# Generate once: npx web-push generate-vapid-keys   (keep the private key secret;
# changing the pair makes every browser subscribe again). Without them,
# development makes and keeps its own pair; production turns web push off.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@example.com
